{
  "branches": ["master"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "VERSION=${nextRelease.version} ./Scripts/build-app.sh && ./Scripts/package-app.sh"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          { "path": "build/VoiceChanger.zip", "label": "VoiceChanger.app (macOS, unsigned)" }
        ]
      }
    ]
  ]
}
